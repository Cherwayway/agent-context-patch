{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fresh Agent paired context rule impact result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "caseId",
    "variant",
    "freshContext",
    "inputDigests",
    "selectedAction",
    "reason",
    "repositoryMutated",
    "privacy"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "caseId": { "type": "string" },
    "variant": { "enum": ["baseline", "candidate"] },
    "freshContext": { "type": "boolean", "const": true },
    "inputDigests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "digest"],
        "properties": {
          "path": { "type": "string" },
          "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "selectedAction": {
      "enum": ["unit_check", "distribution_check", "docs_check"]
    },
    "reason": { "type": "string" },
    "repositoryMutated": { "type": "boolean", "const": false },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rawTraceStored", "absolutePathStored", "secretsStored"],
      "properties": {
        "rawTraceStored": { "type": "boolean", "const": false },
        "absolutePathStored": { "type": "boolean", "const": false },
        "secretsStored": { "type": "boolean", "const": false }
      }
    }
  }
}
